{
  "description": "Record Codex session messages and inject Hypatia memory context",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "hypatia_memory",
            "tool": "agent_session_start",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "last_assistant_message": "${last_assistant_message}",
              "source": "${source}",
              "cwd": "${cwd}",
              "model": "${model}",
              "permission_mode": "${permission_mode}",
              "transcript_path": "${transcript_path}"
            },
            "timeout": 10,
            "statusMessage": "Loading Hypatia memory context at session beginning"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "hypatia_memory",
            "tool": "user_prompt_submission",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "prompt": "${prompt}",
              "last_assistant_message": "${last_assistant_message}",
              "cwd": "${cwd}",
              "model": "${model}",
              "permission_mode": "${permission_mode}",
              "transcript_path": "${transcript_path}"
            },
            "timeout": 10,
            "statusMessage": "Recording user prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "hypatia_memory",
            "tool": "agent_stop",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "last_assistant_message": "${last_assistant_message}",
              "cwd": "${cwd}",
              "stop_hook_active": "${stop_hook_active}",
              "model": "${model}",
              "permission_mode": "${permission_mode}",
              "transcript_path": "${transcript_path}"
            },
            "timeout": 10,
            "statusMessage": "Recording assistant message"
          }
        ]
      }
    ]
  }
}
